---
// Hero keeps the current product hero verbatim: Geomini headline, DM Sans
// subcopy, bottom glow on #080911. The prompt box is zero-JS: a plain form
// with an inline script (same localStorage contract as the app).
---

<main class="relative z-10 flex min-h-screen w-full flex-col items-center justify-center overflow-x-hidden bg-ink pt-16">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-[20%] left-[20%] right-[20%] h-[40vh] rounded-full bg-[radial-gradient(ellipse_at_top,_rgba(59,130,246,0.18)_0%,_transparent_70%)] blur-[90px]"></div>
    <div class="absolute -bottom-[10%] left-[10%] right-[10%] h-[45vh] rounded-full bg-[radial-gradient(ellipse_at_bottom,_rgba(236,72,153,0.35)_0%,_rgba(139,92,246,0.30)_35%,_rgba(59,130,246,0.22)_65%,_transparent_85%)] blur-[90px]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(8,9,17,0.3)_0%,_transparent_80%)]"></div>
  </div>
  <div class="flex w-full max-w-2xl flex-col items-center px-4 text-center">
    <h1 class="mb-4 text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.1] tracking-tight text-white" style="font-family:var(--font-headline)">
      Build with Meshwork Studio
    </h1>
    <p class="mb-10 max-w-[440px] text-[15px] font-medium leading-relaxed text-white/50">
      Describe your infrastructure and Meshwork AI generates a
      complete, interactive cloud diagram — instantly.
    </p>
    <div class="flex w-full max-w-xl justify-center">
      <form
        id="hero-prompt"
        class="flex w-full items-center gap-3 rounded-xl border border-white/[0.08] bg-card px-5 py-3.5"
      >
        <input
          id="hero-prompt-input"
          type="text"
          placeholder="Describe your infrastructure, e.g. A multi-region Kubernetes cluster..."
          aria-label="Describe your infrastructure"
          class="flex-1 bg-transparent text-sm text-white placeholder:text-white/30 focus:outline-none"
        />
        <button type="submit" class="btn-pill btn-pill-solid" style="height:34px">Get started</button>
      </form>
      <script>
        document.getElementById('hero-prompt')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const input = document.getElementById('hero-prompt-input');
          const val = (input?.value ?? '').trim();
          if (!val) return;
          try {
            localStorage.setItem('meshwork_pending_prompt', val);
          } catch {
            // Private mode: still navigate, the app copes without it.
          }
          window.location.href = '/register';
        });
      </script>
    </div>
  </div>
</main>
