---
import templates from '../data/templates.json';
// Templates ready to remix — static cards in our system. Clicking one stashes
// the full template (nodes + edges) for the app to consume after register,
// mirroring the in-app pending_template contract.
---

<section id="templates" class="w-full border-t border-white/10 py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-10">
      <h2 class="text-4xl font-bold tracking-tight text-white" style="font-family:var(--font-headline)">
        Templates ready to remix
      </h2>
      <p class="mt-2 max-w-xl text-[15px] text-white/50">
        Start from a real architecture, not a blank canvas. Pick one and make it yours.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3" id="template-grid">
      {templates.map((t) => (
        <button
          type="button"
          data-template={t.slug}
          class="template-card group rounded-xl border border-white/[0.08] bg-card p-6 text-left transition-colors hover:border-white/20"
        >
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold capitalize text-white" style="font-family:var(--font-headline)">{t.title}</h3>
            {t.stars && <span class="font-mono text-xs text-white/40">★ {t.stars}</span>}
          </div>
          <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-white/50">{t.description}</p>
          <p class="mt-4 text-sm font-medium text-primary">Use this template →</p>
        </button>
      ))}
    </div>
  </div>
</section>

<script define:vars={{ templates }}>
  const grid = document.getElementById('template-grid');
  const bySlug = Object.fromEntries(templates.map((t) => [t.slug, t]));
  grid?.addEventListener('click', (e) => {
    const card = e.target.closest('[data-template]');
    if (!card) return;
    const t = bySlug[card.dataset.template];
    if (!t) return;
    try {
      localStorage.setItem('meshwork_pending_template', JSON.stringify(t));
    } catch {
      // Private mode: continue without the stash.
    }
    window.location.href = '/register';
  });
</script>
