<section id="update-2-0" class="mx-auto max-w-6xl scroll-mt-24 border-t border-white/10 px-6 py-20">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="flex min-h-[320px] flex-col justify-between rounded-xl border border-white/[0.08] bg-surface p-6 md:p-8 lg:min-h-[480px]">
        <div>
          <p class="font-mono text-xs tracking-widest text-primary">UPDATE 2.0</p>
          <h2 class="mt-3 max-w-[14ch] text-4xl font-bold leading-[1.1] tracking-tight text-white" style="font-family:var(--font-headline)">
            Built for operators.
          </h2>
          <p class="mt-3 max-w-md text-[15px] leading-relaxed text-white/50">
            Everything new in 2.0, in six cards. Scroll for each one.
          </p>
        </div>
        <a href="/register" class="btn-pill btn-pill-solid mt-8 self-start">Get started</a>
      </div>
    </aside>
    <div class="space-y-4">
      {items.map((f) => (
        <article id={f.id} class="scroll-mt-24 overflow-hidden rounded-xl border border-white/[0.08] bg-card">
          <div class="flex h-20 items-end bg-surface p-5">
            <span class="font-mono text-xs tracking-widest text-primary">{f.tag}</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-bold text-white" style="font-family:var(--font-headline)">{f.title}</h3>
            <p class="mt-1 text-[15px] leading-relaxed text-white/50">{f.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
