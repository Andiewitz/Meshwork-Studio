---
// Closing call-to-action — mirrors the in-app CTA: headline, example
// prompts, Get started pill. Static; no JS needed.
const examples = [
  'A multi-region Kubernetes cluster with auto-scaling',
  'A real-time data pipeline with event-driven triggers',
  'Help me design a serverless API gateway',
];
---

<section class="relative flex min-h-[60vh] items-center justify-center overflow-hidden border-t border-white/10">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(59,130,246,0.12)_0%,transparent_70%)]"></div>
  </div>
  <div class="relative z-10 mx-auto w-full max-w-2xl px-6 text-center">
    <h2 class="mb-12 text-4xl font-bold leading-tight tracking-tight text-white" style="font-family:var(--font-headline)">
      Bring your ideas to life
    </h2>
    <div class="mb-8 flex items-center gap-3 rounded-xl border border-white/[0.08] bg-card px-5 py-3.5">
      <span class="flex-1 text-left text-sm text-white/30">
        Describe your infrastructure in a sentence or two
      </span>
      <a href="/register" class="btn-pill btn-pill-solid" style="height:34px">Get started</a>
    </div>
    <div class="mx-auto flex max-w-md flex-col items-start gap-3">
      {examples.map((ex) => (
        <p class="text-sm text-white/35">✦ {ex}</p>
      ))}
    </div>
  </div>
</section>
