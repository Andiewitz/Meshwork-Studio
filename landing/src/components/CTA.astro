---
// Bottom CTA — centered display close per §17. Copy at the top.
const title = 'Download Meshwork Studio';
const body =
  'One binary. Point it at a cluster and inspect deployments, pods, and events.';
---

<section id="cta" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-24 text-center">
  <h2
    class="mx-auto max-w-xl text-balance text-[28px] font-semibold tracking-tight text-fg md:text-[34px]"
  >
    {title}
  </h2>
  <p class="mx-auto mt-3 max-w-md text-pretty text-base leading-7 text-muted">
    {body}
  </p>
  <div class="mt-8 flex justify-center">
    <a
      href="#"
      class="inline-flex h-11.5 items-center rounded-full bg-white px-7.5 text-[14px] font-medium text-black transition-colors hover:bg-white/90"
    >
      Download
    </a>
  </div>
</section>
