---
// Showcase — wide sticky display panel with a narrower rail of visual
// principle cards (DESIGN.md §17). Edit the items array to update copy.
const items = [
  {
    id: 'card-flat',
    ref: '§6',
    title: 'Flat inside the islands',
    body: 'Depth comes from surface steps and 1px lines. Shadows exist only on things that float.',
  },
  {
    id: 'card-accent',
    ref: '§3.4',
    title: 'One accent',
    body: 'Blue means interactive, selected, or focused. Accent never signals a status.',
  },
  {
    id: 'card-dense',
    ref: '§5',
    title: 'Dense by default',
    body: '13px text, 24px rows, 4px grid. Whitespace groups; it does not impress.',
  },
  {
    id: 'card-healthy',
    ref: '§3.5',
    title: 'Healthy is not colored',
    body: 'Normal states are neutral. Only exceptions earn color, always with a glyph and a label.',
  },
  {
    id: 'card-prevent',
    ref: '§9',
    title: 'Prevent, then validate',
    body: 'Inputs are constrained so mistakes cannot happen. Problems appear next to the field, never in a modal box.',
  },
  {
    id: 'card-keyboard',
    ref: '§10',
    title: 'Keyboard first',
    body: 'Every control has a visible focus state. Everything reachable by mouse is reachable by keyboard.',
  },
];
---

<section id="features" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-6">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="flex min-h-[320px] flex-col justify-between rounded-lg bg-tool p-6 md:p-8 lg:min-h-[560px]">
        <div>
          <h2 class="max-w-[12ch] text-[34px] font-semibold leading-[1.1] tracking-tight text-fg">
            Built for <span class="text-accent">operators.</span>
          </h2>
          <p class="mt-3 max-w-md text-[13px] leading-5 text-muted">
            Six principles, enforced by tokens. Scroll for each one in full.
          </p>
        </div>
        <a href="#docs" class="mt-8 inline-block text-[13px] text-accent-text transition-colors hover:text-fg">
          Read the specification
        </a>
      </div>
    </aside>
    <div class="space-y-4">
      {
        items.map((f) => (
          <article id={f.id} class="scroll-mt-24 overflow-hidden rounded-lg bg-tool">
            <div class="flex h-28 items-end bg-popup p-5">
              <span class="font-mono text-[44px] leading-none text-disabled">{f.ref}</span>
            </div>
            <div class="p-6">
              <h3 class="text-[13px] font-semibold text-fg">{f.title}</h3>
              <p class="mt-1 text-[13px] leading-5 text-muted">{f.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
