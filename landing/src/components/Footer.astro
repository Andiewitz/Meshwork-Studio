---
// Footer keeps the current product footer verbatim (per scope: everything
// below the hero is redesigned EXCEPT the footer).
const cols = [
  {
    title: 'Platform',
    links: [
      { label: 'Canvas', url: '#templates' },
      { label: 'Templates', url: '#templates' },
    ],
  },
  {
    title: 'Product',
    links: [
      { label: 'Features', url: '#update-2-0' },
      { label: 'Documentation', url: '#docs' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Docs & Blog', url: '#docs' },
      { label: 'Community', url: 'https://github.com/Andiewitz/Meshwork-Studio_/discussions' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', url: '/privacy' },
      { label: 'Terms', url: '/terms' },
    ],
  },
];
---

<footer class="relative z-10 w-full border-t border-white/10 bg-surface">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col items-start justify-between gap-14 md:flex-row">
      <div class="flex max-w-xs flex-col gap-5">
        <h3 class="text-xl font-medium leading-snug text-white">
          Start exploring and building<br />with Meshwork Studio.
        </h3>
        <a href="/register" class="btn-pill btn-pill-outline w-fit">Sign up and get started</a>
      </div>
      <div class="grid grid-cols-2 gap-10 md:grid-cols-4 md:gap-14">
        {cols.map((c) => (
          <div class="flex flex-col gap-3">
            <h4 class="mb-1 text-sm font-semibold text-white">{c.title}</h4>
            {c.links.map((l) => (
              <a href={l.url} class="text-sm text-white/40 transition-colors hover:text-white">{l.label}</a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="w-full overflow-hidden pb-8 pt-4">
    <div class="mx-auto max-w-6xl px-6">
      <p class="select-none text-[clamp(3rem,10vw,8rem)] font-bold leading-none tracking-tighter text-white/[0.06]" aria-hidden="true">
        Meshwork Studio
      </p>
    </div>
  </div>
</footer>
