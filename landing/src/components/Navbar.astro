---
// Top navigation — pure static Astro (no JS): desktop row + CSS-only mobile
// menu. Buttons are verbatim redesign pills in Inter; everything else follows
// the product system. Sign in → /login, Get started → /register.
const links = [
  { title: 'Templates', url: '#templates' },
  { title: 'Update 2.0', url: '#update-2-0' },
  { title: 'Docs', url: '#docs' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-ink/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="Meshwork Studio home">
      <svg viewBox="0 0 100 100" fill="none" class="h-7 w-7" aria-hidden="true">
        <defs>
          <linearGradient id="mw-nav-fill" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#FF6B35"></stop>
            <stop offset="38%" stop-color="#F43F5E"></stop>
            <stop offset="70%" stop-color="#D946EF"></stop>
            <stop offset="100%" stop-color="#3B82F6"></stop>
          </linearGradient>
        </defs>
        <polygon points="4,92 96,92 96,8" fill="url(#mw-nav-fill)"></polygon>
      </svg>
      <span class="hidden text-[17px] font-bold tracking-tight text-white sm:block" style="font-family:var(--font-headline)">Meshwork Studio</span>
    </a>
    <div class="hidden items-center gap-8 lg:flex">
      {links.map((l) => (
        <a href={l.url} class="text-sm font-medium text-white/60 transition-colors hover:text-white">{l.title}</a>
      ))}
    </div>
    <div class="hidden items-center gap-3 lg:flex">
      <a href="/login" class="btn-pill btn-pill-outline">Sign in</a>
      <a href="/register" class="btn-pill btn-pill-solid">Get started</a>
    </div>
    <details class="lg:hidden">
      <summary class="btn-pill btn-pill-outline list-none" aria-label="Open menu">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <div class="absolute inset-x-0 top-16 border-b border-white/10 bg-ink px-6 pb-6 pt-2">
        <div class="flex flex-col gap-4">
          {links.map((l) => (
            <a href={l.url} class="text-base font-medium text-white/70">{l.title}</a>
          ))}
          <div class="flex gap-3 pt-2">
            <a href="/login" class="btn-pill btn-pill-outline flex-1">Sign in</a>
            <a href="/register" class="btn-pill btn-pill-solid flex-1">Get started</a>
          </div>
        </div>
      </div>
    </details>
  </nav>
</header>
