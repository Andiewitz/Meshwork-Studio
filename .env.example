# === DATABASES ===
DATABASE_URL=postgresql://user:password@your-rds-host:5432/emnesh_workspace
AUTH_DATABASE_URL=postgresql://user:password@your-rds-host:5432/emnesh_auth

# === REDIS ===
REDIS_URL=redis://your-elasticache-host:6379

# === APP ===
NODE_ENV=production
PORT=5000
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# === SECRETS (generate these) ===
SESSION_SECRET=           # openssl rand -base64 32
JWT_SECRET=               # openssl rand -base64 64
ADMIN_SECRET=             # make something up, used for admin panel access

# === AI ===
GEMINI_API_KEY=           # your google gemini key
OPENROUTER_API_KEY=       # your openrouter key

# === GOOGLE OAUTH (optional, leave blank if not using) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === SMTP (optional, leave blank to use console logging instead) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
