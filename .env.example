# === DATABASES (database-per-service; single Postgres, scoped users) ===
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=     # openssl rand -base64 24

AUTH_DB_PASSWORD=                # each service's password opens ONLY its own db
WORKSPACE_DB_PASSWORD=
TEAM_DB_PASSWORD=
AI_DB_PASSWORD=
METRICS_DB_PASSWORD=

AUTH_DATABASE_URL=postgresql://auth_app:<AUTH_DB_PASSWORD>@localhost:5434/auth_db
WORKSPACE_DATABASE_URL=postgresql://workspace_app:<WORKSPACE_DB_PASSWORD>@localhost:5434/workspace_db
TEAM_DATABASE_URL=postgresql://team_app:<TEAM_DB_PASSWORD>@localhost:5434/team_db
AI_DATABASE_URL=postgresql://ai_app:<AI_DB_PASSWORD>@localhost:5434/ai_db
METRICS_DATABASE_URL=postgresql://metrics_app:<METRICS_DB_PASSWORD>@localhost:5434/metrics_db
# === CANVAS (DynamoDB — free tier) ===
CANVAS_DDB_TABLE=meshwork-canvas
AWS_REGION=us-east-1
# Production only (IAM user meshwork-canvas). Local uses dynamo-local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === REDIS ===
REDIS_URL=redis://your-elasticache-host:6379
AUTH_REDIS_URL=redis://your-elasticache-host:6379  # Go auth service reads this separately; required for OAuth

# === APP ===
NODE_ENV=production
PORT=5000
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# === SECRETS (generate with openssl rand -base64 32) ===
SESSION_SECRET=                 # express cookie signing (monolith)
METRICS_BEARER_TOKEN=           # gates GET /metrics on the monolith

# === AUTH SERVICE (server/services/auth — see important/SECRETS.md) ===
AUTH_ASSERTION_PUBLIC_KEY=      # ed25519 seed shared with the monolith for local verification
AUTH_INTERNAL_KEY=              # shared secret for monolith→auth session introspection

# === AI ===
GEMINI_API_KEY=           # your google gemini key
OPENROUTER_API_KEY=       # your openrouter key

# === GOOGLE OAUTH (optional, leave blank if not using) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === SMTP (optional, leave blank to use console logging instead) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
