# Copy this file to .env, then run `npm run diagnose`.
# For a complete local-only configuration, use `npm run setup` instead.
# Do not use generated development values in production.

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
APP_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000

# Docker PostgreSQL service credentials
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
AUTH_DB_PASSWORD=
WORKSPACE_DB_PASSWORD=
TEAM_DB_PASSWORD=
AI_DB_PASSWORD=
METRICS_DB_PASSWORD=
JENKOS_DB_PASSWORD=

# Native Node/Go development connections; Compose supplies container addresses.
AUTH_DATABASE_URL=postgresql://auth_app:<AUTH_DB_PASSWORD>@localhost:5434/auth_db
WORKSPACE_DATABASE_URL=postgresql://workspace_app:<WORKSPACE_DB_PASSWORD>@localhost:5434/workspace_db
TEAM_DATABASE_URL=postgresql://team_app:<TEAM_DB_PASSWORD>@localhost:5434/team_db
AI_DATABASE_URL=postgresql://ai_app:<AI_DB_PASSWORD>@localhost:5434/ai_db
METRICS_DATABASE_URL=postgresql://metrics_app:<METRICS_DB_PASSWORD>@localhost:5434/metrics_db
REDIS_URL=redis://localhost:6379
AUTH_REDIS_URL=redis://localhost:6379

# Local DynamoDB uses these non-production placeholder credentials.
CANVAS_DDB_TABLE=meshwork-canvas
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Required local cryptographic configuration. Generate with `npm run setup`.
SESSION_SECRET=
METRICS_BEARER_TOKEN=
INTERNAL_API_KEY=
AUTH_INTERNAL_KEY=
AUTH_IP_HASH_KEY=
AUTH_ENCRYPTION_KEY=
AUTH_ASSERTION_PRIVATE_KEY=
# Raw base64 Ed25519 public key only; never copy the private seed here.
AUTH_ASSERTION_PUBLIC_KEY=
# 32-byte base64 key for encrypted BYOK provider credentials.
ENCRYPTION_KEY=
AUTH_SERVICE_URL=http://localhost:8081

# Optional integrations
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
