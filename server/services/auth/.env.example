# ─── IDENTITY SERVICE ────────────────────────────────────────────────────────
# This service owns its environment. Nothing here is shared with the Node
# monolith except infrastructure endpoints (databases, redis) and public URL.

NODE_ENV=development        # production | development | test
AUTH_PORT=8081

# Canonical public origin (scheme + host). Required in production.
APP_PUBLIC_URL=http://localhost:5000
# Additional exact origins allowed to make state-changing browser requests:
EXTRA_ALLOWED_ORIGINS=

# Postgres database this service OWNS (users, sessions, tokens, audit).
AUTH_DATABASE_URL=postgresql://user:password@localhost:5433/meshwork_auth

# Redis for session cache, rate limits, MFA tickets, OAuth state.
AUTH_REDIS_URL=redis://localhost:6379

# ─── Keys (generate: openssl rand -base64 32) ────────────────────────────────
AUTH_IP_HASH_KEY=
AUTH_ENCRYPTION_KEY=

# ─── Sessions ─────────────────────────────────────────────────────────────────
SESSION_ABSOLUTE_TTL=336h    # 14 days hard ceiling
SESSION_IDLE_TTL=168h        # 7 days inactivity expiry
SESSION_TOUCH_EVERY=1m

# Proxies allowed to set X-Forwarded-For (comma-separated CIDRs).
TRUSTED_PROXIES=127.0.0.1,::1

# Per-IP sliding-window limit on login/register per 15 minutes.
LOGIN_RATE_LIMIT_PER_IP=20

# ─── Email (required in production) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Meshwork <no-reply@your-domain.com>"

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── CAPTCHA (optional; recaptcha | hcaptcha) ─────────────────────────────────
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
CAPTCHA_MIN_SCORE=0.5

# Comma-separated emails promoted to admin at boot if they exist.
BOOTSTRAP_ADMIN_EMAILS=
